<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/clipboard_overlay_bg"
    android:padding="16dp"
    android:elevation="8dp">

    <!-- Header bar -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tv_clipboard_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/clipboard_title"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/on_surface"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true" />

        <ImageButton
            android:id="@+id/btn_clear_all"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_delete"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/clear_all"
            android:layout_toStartOf="@id/btn_close_clipboard"
            android:layout_centerVertical="true"
            android:padding="6dp"
            android:layout_marginEnd="8dp"
            tools:ignore="RtlSymmetry" />

        <ImageButton
            android:id="@+id/btn_close_clipboard"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_close"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/close"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="6dp" />

    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider" />

    <!-- Empty state message -->
    <TextView
        android:id="@+id/tv_empty_clipboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/clipboard_empty"
        android:textSize="14sp"
        android:textColor="@color/on_surface_secondary"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone" />

    <!-- Clipboard items list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_clipboard_items"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="8dp" />

</LinearLayout>
